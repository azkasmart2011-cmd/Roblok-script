-- ============================================
-- HOTKEY SETUP
-- ============================================

local function SetupHotkeys()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        -- KILL ALL (X)
        if input.KeyCode == Enum.KeyCode.X then
            if KillerManager:CheckIfImKiller() then
                KillAllModule:Execute()
            else
                print("❌ You are not the killer!")
            end
        end
        
        -- TOGGLE ESP (J)
        if input.KeyCode == Enum.KeyCode.J then
            Settings.ShowESP = not Settings.ShowESP
            print("[ESP] " .. (Settings.ShowESP and "ON" or "OFF"))
        end
        
        -- TOGGLE RADAR (R)
        if input.KeyCode == Enum.KeyCode.R then
            RadarEnabled = not RadarEnabled
            if RadarEnabled then CreateRadar() end
            print("[RADAR] " .. (RadarEnabled and "ON" or "OFF"))
        end
    end)
end

-- ============================================
-- HEALTH MONITOR
-- ============================================

local function StartHealthMonitor()
    task.spawn(function()
        while true do
            task.wait(0.3)
            for _, esp in pairs(ESPObjects) do
                local char = esp.Player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        esp.HealthPercent = (hum.Health / hum.MaxHealth) * 100
                    end
                end
            end
        end
    end)
end

-- ============================================
-- KILLER SCAN LOOP
-- ============================================

local function StartKillerScanner()
    task.spawn(function()
        while true do
            task.wait(0.3)
            -- CEK SIAPA KILLER (SELAIN DIRI SENDIRI)
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    if char then
                        -- CEK SENJATA
                        if char:FindFirstChildOfClass("Tool") then
                            CurrentKiller = player
                            break
                        end
                        -- CEK TAG
                        if char:FindFirstChild("KillerTag") or char:FindFirstChild("Murderer") then
                            CurrentKiller = player
                            break
                        end
                    end
                end
            end
        end
    end)
end

-- ============================================
-- MAIN INITIALIZATION
-- ============================================

local function Initialize()
    -- BUAT ESP UNTUK PLAYER YANG SUDAH ADA
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            ESPObjects[player] = CreateESP(player)
        end
    end
    
    -- PLAYER ADDED
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            ESPObjects[player] = CreateESP(player)
        end
    end)
    
    -- PLAYER REMOVED
    Players.PlayerRemoved:Connect(function(player)
        local esp = ESPObjects[player]
        if esp then
            esp.Box:Remove()
            esp.Name:Remove()
            esp.Distance:Remove()
            esp.Health:Remove()
           ESPObjects[player] = nil
        end
    end)
    
    -- RENDER LOOP
    RunService.RenderStepped:Connect(function()
        KillerManager:CheckIfImKiller()
        for _, esp in pairs(ESPObjects) do
            UpdateESP(esp)
        end
        UpdateRadar()
    end)
    
    -- START MODULES
    CreateUI()
    CreateRadar()
    SetupHotkeys()
    StartHealthMonitor()
    StartKillerScanner()
    
    print("✅ Script loaded successfully!")
end

-- RUN
pcall(Initialize)
