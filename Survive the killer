local KillerManager = {
    AmIKiller = false,
    CurrentKiller = nil,
    MyWeapon = nil,
}

function KillerManager:CheckIfImKiller()
    local character = LocalPlayer.Character
    if not character then return false end
    
    -- CEK APAKAH PEMAIN INI KILLER
    local weapon = character:FindFirstChildOfClass("Tool")
    if weapon then
        self.AmIKiller = true
        self.MyWeapon = weapon
        return true
    end
    
    local killerTag = character:FindFirstChild("KillerTag") or 
                      character:FindFirstChild("Murderer") or
                      character:FindFirstChild("Killer")
    if killerTag then
        self.AmIKiller = true
        return true
    end
    
    self.AmIKiller = false
    return false
end

-- ============================================
-- KILL ALL MODULE - TELEPORT + INSTANT KILL
-- ============================================

local KillAllModule = {
    IsKilling = false,
    KillQueue = {},
    KillCount = 0,
    TargetList = {},
}

function KillAllModule:GetAllTargets()
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    table.insert(targets, {
                        player = player,
                        character = character,
                        rootPart = character.HumanoidRootPart,
                        humanoid = humanoid,
                    })
                end
            end
        end
    end
    return targets
end

function KillAllModule:TeleportToTarget(targetPos)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return false end
    
    -- TELEPORT INSTAN
    rootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
    task.wait(0.05)
    return true
end

function KillAllModule:ExecuteKill(target)
    -- METHOD 1: PAKE TOOL (SENJATA)
    local character = LocalPlayer.Character
    if not character then return false end
    
    local weapon = KillerManager.MyWeapon
    if weapon then
        -- EQUIP SENJATA
        local tool = character:FindFirstChildWhichIsA("Tool")
        if tool then
            tool.Parent = character
            task.wait(0.02)
        end
        
        -- CLICK / ATTACK
        VirtualInputManager:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, 0, 0, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(Enum.UserInputType.MouseButton1, 0, 0, false, game, 0)
        task.wait(0.05)
        
        -- LANGSUNG HAPUS HP
        if target.humanoid then
            target.humanoid.Health = 0
        end
        return true
    end
    
    -- METHOD 2: LANGSUNG SET HEALTH KE 0
    if target.humanoid then
        target.humanoid.Health = 0
        return true
    end
    
    return false
end

function KillAllModule:StartKillAll()
    if self.IsKilling then
        print("⚠️ [KILLALL] Already in progress!")
        return
    end
    
    if not KillerManager:CheckIfImKiller() then
        print("❌ [KILLALL] You are not the KILLER! Can't use kill all!")
        return
    end
    
    self.IsKilling = true
    self.KillCount = 0
    self.TargetList = self:GetAllTargets()
    
    if #self.TargetList == 0 then
        print("⚠️ [KILLALL] No targets found!")
        self.IsKilling = false
        return
    end
    
    print("========================================")
    print("🔪 [KILLALL] INITIATED! 🔪")
    print("📊 Total targets: " .. #self.TargetList)
    print("========================================")
    
    local startTime = tick()
    
    for i, target in ipairs(self.TargetList) do
        if not target.rootPart then
            print("⚠️ Skipping " .. target.player.Name .. " - no root part")
            goto continue
        end
        
        -- TELEPORT KE TARGET
        local targetPos = target.rootPart.Position
        self:TeleportToTarget(targetPos)
        
        -- EKSEKUSI KILL
        local success = self:ExecuteKill(target)
        
        if success then
            self.KillCount = self.KillCount + 1
            print("✅ [" .. self.KillCount .. "/" .. #self.TargetList .. "] Killed: " .. target.player.Name)
        else
            print("❌ Failed to kill: " .. target.player.Name)
        end
        
        -- DELAY ANTAR KILL
        task.wait(Settings.AutoKillDelay)
        
        ::continue::
    end
    
    local elapsed = tick() - startTime
    print("========================================")
    print("🔪 [KILLALL] COMPLETED! 🔪")
    print("✅ Killed: " .. self.KillCount .. " players")
    print("⏱️ Time: " .. string.format("%.2f", elapsed) .. " seconds")
    print("========================================")
    
    self.IsKilling = false
end

