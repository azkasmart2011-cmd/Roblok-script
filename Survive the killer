function SetupHotkey()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        -- TOMOL X UNTUK KILL ALL
        if input.KeyCode == Enum.KeyCode.X then
            if KillerManager:CheckIfImKiller() then
                KillAllModule:StartKillAll()
            else
                print("❌ You are not the killer! Can't use kill all!")
            end
        end
        
        -- TOMOL J UNTUK TOGGLE ESP
        if input.KeyCode == Enum.KeyCode.J then
            Settings.ShowESP = not Settings.ShowESP
            print("[ESP] Toggled: " .. tostring(Settings.ShowESP))
        end
    end)
end

-- ============================================
-- ESP DRAWING MODULE (SAMA KAYA SEBELUMNYA)
-- ============================================

local ESPModule = {}
ESPModule.__index = ESPModule

function ESPModule:New(player)
    local self = setmetatable({}, ESPModule)
    self.Player = player
    self.Enabled = true
    self.Distance = math.huge
    self.IsKiller = false
    self.HealthPercent = 100
    
    self.Box = Drawing.new("Square")
    self.Box.Visible = false
    self.Box.Thickness = Settings.BoxThickness
    self.Box.Filled = false
    
    self.NameTag = Drawing.new("Text")
    self.NameTag.Visible = false
    self.NameTag.Size = Settings.FontSize
    self.NameTag.Center = true
    self.NameTag.Outline = true
    self.NameTag.OutlineColor = Color3.new(0, 0, 0)
    
    self.DistanceTag = Drawing.new("Text")
    self.DistanceTag.Visible = false
    self.DistanceTag.Size = Settings.FontSize - 2
    self.DistanceTag.Center = true
    self.DistanceTag.Outline = true
    
    self.HealthBar = Drawing.new("Line")
    self.HealthBar.Visible = false
    self.HealthBar.Thickness = 3
    
    return self
end

function ESPModule:Update()
    if not Settings.ShowESP or not self.Enabled then
        self:SetVisible(false)
        return
    end
    
    local character = self.Player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        self:SetVisible(false)
        return
    end
    
    local rootPart = character.HumanoidRootPart
    local rootPos = rootPart.Position
    local cameraPos = Camera.CFrame.Position
    
    self.Distance = (cameraPos - rootPos).Magnitude
    
    if self.Distance > Settings.MaxDistance then
        self:SetVisible(false)
        return
    end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(rootPos)
    
    if not onScreen or screenPos.Z < 0 then
        self:SetVisible(false)
        return
    end
    
    local sizeScale = 3.5 / (screenPos.Z / 10)
    local boxSize = Vector2.new(80 * sizeScale, 100 * sizeScale)
    local boxPos = Vector2.new(screenPos.X - boxSize.X/2, screenPos.Y - boxSize.Y)
    
    self.Box.Position = boxPos
    self.Box.Size = boxSize
    
    self.NameTag.Position = Vector2.new(screenPos.X, boxPos.Y - 18)
    self.NameTag.Text = self.Player.Name
    
    self.DistanceTag.Position = Vector2.new(screenPos.X, boxPos.Y + boxSize.Y + 5)
    self.DistanceTag.Text = string.format("%.0fm", self.Distance)
    
    local healthY = boxPos.Y + boxSize.Y + 2
    local healthWidth = boxSize.X * (self.HealthPercent / 100)
    self.HealthBar.From = Vector2.new(boxPos.X, healthY)
    self.HealthBar.To = Vector2.new(boxPos.X + healthWidth, healthY)
    
    if self.IsKiller then
        self.Box.Color = Colors.Killer
        self.NameTag.Color = Colors.Killer
    else
        self.Box.Color = Colors.Survivor
        self.NameTag.Color = Colors.Survivor
    end
    self.DistanceTag.Color = Colors.DistanceText
    
    if self.HealthPercent > 50 then
        self.HealthBar.Color = Colors.HealthBar
    else
        self.HealthBar.Color = Colors.HealthBarLow
    end
    
    self:SetVisible(true)
end

function ESPModule:SetVisible(visible)
    self.Box.Visible = visible and Settings.ShowBox
    self.NameTag.Visible = visible and Settings.ShowName
    self.DistanceTag.Visible = visible and Settings.ShowDistance
    self.HealthBar.Visible = visible and Settings.ShowHealth
end

function ESPModule:Destroy()
    self.Box:Remove()
    self.NameTag:Remove()
    self.DistanceTag:Remove()
    self.HealthBar:Remove()
end

-- ============================================
-- ESP MANAGER
-- ============================================

local ESPManager = {
    ActiveESPs = {},
    CurrentKiller = nil,
}

function ESPManager:Initialize()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            self:AddPlayer(player)
        end
    end
    
    Players.PlayerAdded:Connect(function(player)
        if player ~= LocalPlayer then
            self:AddPlayer(player)
        end
    end)
    
    Players.PlayerRemoved:Connect(function(player)
        self:RemovePlayer(player)
    end)
    
    RunService.RenderStepped:Connect(function()
        -- UPDATE KILLER DETECTION
        KillerManager:CheckIfImKiller()
        
        -- UPDATE ESP
        for _, esp in pairs(self.ActiveESPs) do
            esp.IsKiller = (esp.Player == KillerManager.CurrentKiller)
            esp:Update()
        end
    end)
    
    -- UPDATE HEALTH
    task.spawn(function()
        while true do
            task.wait(0.5)
            for _, esp in pairs(self.ActiveESPs) do
                local char = esp.Player.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        esp.HealthPercent = (hum.Health / hum.MaxHealth) * 100
                    end
                end
            end
        end
    end)
end

function ESPManager:AddPlayer(player)
    local esp = ESPModule:New(player)
    self.ActiveESPs[player] = esp
end

function ESPManager:RemovePlayer(player)
    local esp = self.ActiveESPs[player]
    if esp then
        esp:Destroy()
        self.ActiveESPs[player] = nil
    end
end

